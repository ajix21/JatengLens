# Token bot Telegram dari @BotFather
# (Disarankan buat bot khusus homelab agar notifikasi terpisah dari bot SocioWatch,
# atau bisa juga pakai token bot yang sama selama tidak ada poller getUpdates lain)
TELEGRAM_BOT_TOKEN=

# Wajib: Daftar Chat ID Telegram yang diizinkan mengakses bot (pisahkan koma jika lebih dari satu)
ALLOWED_CHAT_IDS=7754154315

# Label nama server yang tampil di pesan Telegram
HOST_LABEL=Homelab-ThinkPad-E470

# Auto-Alert Proaktif (true/false)
ALERT_ENABLED=true
CHECK_INTERVAL_SEC=60
ALERT_COOLDOWN_SEC=900

# Ambang batas alert (%)
CPU_THRESHOLD=90
RAM_THRESHOLD=85
SWAP_THRESHOLD=85
DISK_THRESHOLD=85
